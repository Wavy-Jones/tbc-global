.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environment
venv/
ENV/
env/
.venv

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# VS Code
.vscode/
*.code-workspace

# Environment variables
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3
*.sql

# Logs
*.log
logs/
*.log.*

# OS
.DS_Store
Thumbs.db
desktop.ini

