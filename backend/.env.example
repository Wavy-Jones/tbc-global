# TBC Global - Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=TBC Global Loan Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tbc_loans
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=True

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx
UPLOAD_DIR=./uploads

# AWS S3 (for production file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=af-south-1
S3_BUCKET_NAME=tbc-loans-documents

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@tbcglobal.co.za
EMAIL_FROM_NAME=TBC Global

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+27123456789

# SMS (BulkSMS Alternative)
BULKSMS_USERNAME=your-bulksms-username
BULKSMS_PASSWORD=your-bulksms-password

# WhatsApp (Twilio)
WHATSAPP_FROM=whatsapp:+14155238886

# PayFast
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_MODE=sandbox  # or 'live'
PAYFAST_SANDBOX_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_LIVE_URL=https://www.payfast.co.za/eng/process

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Credit Bureau (Optional - for Premium features)
EXPERIAN_API_KEY=your-experian-api-key
EXPERIAN_API_URL=https://api.experian.co.za
TRANSUNION_API_KEY=your-transunion-api-key
TRANSUNION_API_URL=https://api.transunion.co.za

# Business Rules
MIN_LOAN_AMOUNT=500
MAX_LOAN_AMOUNT=5500
MIN_MONTHLY_INCOME=4000
MAX_DEBT_TO_INCOME_RATIO=0.4
MIN_CREDIT_SCORE=550

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Frontend URL (for email links, etc.)
FRONTEND_URL=http://localhost:3000

# Compliance
COMPANY_NAME=TBC Global
COMPANY_REGISTRATION=2026/000000/07
NCR_REGISTRATION=NCRCP0000
CONTACT_EMAIL=info@tbcglobal.co.za
CONTACT_PHONE=+27123456789
